<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of AtomicVault rides in a cloud backup or a device-to-device
  transfer. android:allowBackup="false" alone does not stop device-to-device
  transfer on Android 12+, and a transferred vault database arrives without
  the Keystore keys that open its envelope, leaving an unusable vault on the
  new phone. Moving a vault between phones is done with an encrypted backup
  file (Settings > Backup), which the user controls.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
